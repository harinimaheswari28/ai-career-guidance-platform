# Flask Configuration
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-32chars
PORT=5000

# Database Configuration (MySQL Recommended)
# For MySQL: mysql+pymysql://<user>:<password>@localhost:3306/<database_name>
# If omitted or unavailable, backend defaults to local SQLite for instant zero-config evaluation
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_career_db

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-jwt-secret-key-64chars

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173

# Initial Administrator Credentials (used during seed script initialization)
ADMIN_INIT_NAME=System Administrator
ADMIN_INIT_EMAIL=admin@aicareer.edu
ADMIN_INIT_PASSWORD=AdminPass@2026
